# ──────────────────────────────────────────────────────────────────────────────
#  TruthLens Backend — Environment Variables Template
#  Copy to .env and fill in your credentials before starting the server.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Cross-Lingual Multimodal Fact Verification System
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Google AI / Gemini ───────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ─── Embedding & NLI Models ───────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# ─── Neo4j Knowledge Graph ────────────────────────────────────────────────────
# Set USE_NEO4J=true to use a live Neo4j instance; false uses NetworkX in-memory
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
# Set USE_QDRANT=true to use Qdrant; false uses in-memory vector store
USE_QDRANT=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=truthlens_evidence

# ─── Scoring Weights (must sum to 1.0) ───────────────────────────────────────
NLI_WEIGHT=0.40
BM25_WEIGHT=0.20
DENSE_WEIGHT=0.25
GRAPH_WEIGHT=0.15
